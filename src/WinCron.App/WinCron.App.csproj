<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>wincron</AssemblyName>
    <RootNamespace>WinCron.App</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.1.0</Version>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinCron.Core\WinCron.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 同一 ico 内嵌，供 NotifyIcon 运行时加载（保留多尺寸，托盘 16x16 清晰，SPEC §11） -->
    <EmbeddedResource Include="..\..\assets\app.ico" LogicalName="WinCron.app.ico" />
  </ItemGroup>

</Project>
